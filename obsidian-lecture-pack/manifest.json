{
  "name": "obsidian-lecture-pack",
  "display_name": "Obsidian 일반 강의팩",
  "version": "1.2.0",
  "scope": "general-lecture-only",
  "architecture": [
    "evidence-first-bookmarks",
    "domain-isolated-sync-pack"
  ],
  "default_command": "/obsidianpack",
  "aliases": [
    "/obsidian",
    "/obsidian-general",
    "/obsidianpack-general",
    "/옵시디언팩만들어줘"
  ],
  "prompt": "prompts/notebooklm-general.md",
  "allowed_units": [
    "topic",
    "chapter",
    "concept",
    "case",
    "example",
    "procedure",
    "practice",
    "qa",
